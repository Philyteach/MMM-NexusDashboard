// secrets.h.example
// Copy this file to secrets.h and fill in your real values.
// secrets.h is gitignored - never commit your real credentials.

#define WIFI_SSID      "your-network-name"
#define WIFI_PASSWORD  "your-network-password"
#define MQTT_HOST      "server1"    // hostname or IP of your MQTT broker
#define MQTT_PORT      1883
#define MQTT_USER      "your-mqtt-username"   // leave "" if the broker allows anonymous access
#define MQTT_PASSWORD  "your-mqtt-password"   // leave "" if the broker allows anonymous access
#define NODE_NAME      "attic"      // unique per physical node - e.g. "attic", "school-office"
