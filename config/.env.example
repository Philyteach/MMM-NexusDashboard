# Copy this file to config/.env and fill in real values.
# This file (.env.example) is safe to commit — it contains no secrets.

# GPS coordinates for this deployment (home vs. school Pi will differ)
LATITUDE=
LONGITUDE=

# Google Calendar ICS feed URL for this deployment
CALENDAR_URL=

# Immich server connection (self-hosted photo server for the slideshow card)
IMMICH_URL=
IMMICH_API_KEY=
IMMICH_ALBUM_ID=

# Travel/Commute card - Google Distance Matrix API (traffic-aware).
# Requires billing enabled on the Google Cloud project; set a daily
# element quota cap in the Console as a safety net.
GOOGLE_MAPS_API_KEY=
HOME_ADDRESS=

# Two fixed commute tiles. WINDOW_START/END (24h HH:MM, local time) is when
# the tile shows a "leave by" countdown instead of a plain drive time.
COMMUTE_1_LABEL=
COMMUTE_1_DEST=
COMMUTE_1_WINDOW_START=07:00
COMMUTE_1_WINDOW_END=08:00

COMMUTE_2_LABEL=
COMMUTE_2_DEST=
COMMUTE_2_WINDOW_START=06:00
COMMUTE_2_WINDOW_END=07:00

 # Is there a chance to see the Aurora tonight? Set your threshold.  Requires LATITUDE AND LONGITUDE lines.
 AURORA_KP_THRESHOLD=6

# Self-hosted ntfy instance for fridge/freezer latch push notifications.
# TOKEN needs write access to the topic - if the topic denies anonymous
# access, pushes fail silently without it. Generate one on the ntfy server
# with: ntfy token add <user>
FRIDGE_NTFY_HOST=
FRIDGE_NTFY_TOPIC=
FRIDGE_NTFY_TOKEN=

# Xweather (AerisWeather Contributor Plan) - lightning threat badge.
# Get these from the Xweather dashboard after your PWSWeather station
# passes QA (see PWSWEATHER_* above). Leave blank to disable. Uses the
# LATITUDE/LONGITUDE lines above for the query point - no separate
# coordinates needed here.
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
XWEATHER_POLL_INTERVAL_MS=
