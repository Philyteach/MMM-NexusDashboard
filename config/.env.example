# Copy this file to config/.env and fill in real values.
# This file (.env.example) is safe to commit — it contains no secrets.

# GPS coordinates for this deployment (home vs. school Pi will differ)
LATITUDE=
LONGITUDE=

# Google Calendar ICS feed URL for this deployment
CALENDAR_URL=

# Immich server connection (self-hosted photo server for the slideshow card)
IMMICH_URL=
IMMICH_API_KEY=
IMMICH_ALBUM_ID=

# Travel/Commute card - Google Distance Matrix API (traffic-aware).
# Requires billing enabled on the Google Cloud project; set a daily
# element quota cap in the Console as a safety net.
GOOGLE_MAPS_API_KEY=
HOME_ADDRESS=

# Two fixed commute tiles. WINDOW_START/END (24h HH:MM, local time) is when
# the tile shows a "leave by" countdown instead of a plain drive time.
COMMUTE_1_LABEL=
COMMUTE_1_DEST=
COMMUTE_1_WINDOW_START=07:00
COMMUTE_1_WINDOW_END=08:00

COMMUTE_2_LABEL=
COMMUTE_2_DEST=
COMMUTE_2_WINDOW_START=06:00
COMMUTE_2_WINDOW_END=07:00

 # Is there a chance to see the Aurora tonight? Set your threshold.  Requires LATITUDE AND LONGITUDE lines.
 AURORA_KP_THRESHOLD=6

# Self-hosted ntfy instance for fridge/freezer latch push notifications.
# TOKEN needs write access to the topic - if the topic denies anonymous
# access, pushes fail silently without it. Generate one on the ntfy server
# with: ntfy token add <user>
FRIDGE_NTFY_HOST=
FRIDGE_NTFY_TOPIC=
FRIDGE_NTFY_TOKEN=

# CARTO Basemaps API key - required as of Aug 2026 for the radar map's dark
# basemap (RadarCard.js / RadarFullCard.js), or tiles render with an
# "API KEY REQUIRED" watermark. Free key from https://carto.com/basemaps/apikey
CARTO_API_KEY=your_carto_key_here
# raster (default) or vector - vector needs a working WebGL/GPU-accelerated
# Electron (see ELECTRON_ENABLE_GPU in electron.js). Leave as raster unless
# you've confirmed that works on your hardware.
CARTO_BASEMAP_MODE=raster

# Xweather (AerisWeather Contributor Plan) - lightning threat badge.
# Get these from the Xweather dashboard after your PWSWeather station
# passes QA (see PWSWEATHER_* above). Leave blank to disable. Uses the
# LATITUDE/LONGITUDE lines above for the query point - no separate
# coordinates needed here.
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
XWEATHER_POLL_INTERVAL_MS=

# Local AS3935 lightning sensor (School workspace only - see
# cards/LightningStrikeCard.js). Unrelated to the Xweather block above:
# this is a physical GY-AS3935 board wired over SPI, not a cloud feed.
# Leave LIGHTNING_SENSOR_ENABLED unset/blank on any deployment without the
# sensor wired up (e.g. this repo's Home Pi) for zero behavior change.
LIGHTNING_SENSOR_ENABLED=
# Override only if `python3` isn't the right interpreter for this
# deployment (e.g. a venv) - default spawns
# scripts/lightning/lightning_daemon.py directly.
LIGHTNING_SENSOR_COMMAND=
LIGHTNING_SENSOR_ARGS=
# 0-7 / 0-10. Defaults (7/10) were tuned against a board sitting on a
# breadboard right next to a Pi 4, where the factory defaults (2/2)
# produced hundreds of false disturber/noise events per second from the
# Pi's own RF noise - see scripts/lightning/lightning_daemon.py's
# docstring. Lower these if the sensor ends up mounted further away.
LIGHTNING_NOISE_FLOOR=
LIGHTNING_WATCHDOG_THRESHOLD=
# BCM pin the AS3935 IRQ line is wired to.
LIGHTNING_IRQ_GPIO=
